# Copie este arquivo para "backend/.env" e ajuste os valores.
# O Fluxy le o .env sozinho ao iniciar (nao precisa de nada extra instalado).
# O arquivo .env NUNCA deve ir para o Git: ele guarda senhas.

# ---------- Ambiente ----------
# Deixe em branco no seu computador. Use "production" no servidor publicado:
# o navegador nao e aberto sozinho e as configuracoes abaixo passam a ser exigidas.
NODE_ENV=

# ---------- Banco de dados (PostgreSQL) ----------
# Opcao 1: uma unica URL de conexao (tem prioridade sobre as variaveis abaixo).
# Troque SUA_SENHA pela senha do usuario "postgres". Em bancos hospedados, a
# URL costuma terminar com ?sslmode=require
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/fluxy_db

# Opcao 2: variaveis separadas, usadas se DATABASE_URL nao for definida
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=SUA_SENHA
# PGDATABASE=fluxy_db

# ---------- Servidor ----------
# Porta/host onde o Fluxy (frontend + API) vai rodar. 127.0.0.1 aceita so
# conexoes deste computador; em Render/Railway/Docker use 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8080

# Endereco publico do site, sem barra no final. Entra no link de redefinicao
# de senha enviado por e-mail. Obrigatorio em producao (ex.: https://app.seudominio.com.br).
APP_URL=http://localhost:8080

# ---------- E-mail (redefinicao de senha) ----------
# Sem SMTP_HOST e MAIL_FROM o "Esqueci minha senha" fica indisponivel e avisa
# isso na tela. Use os dados do seu provedor (Gmail, Outlook, Brevo, Zoho...).
#   porta 587 -> SMTP_SECURE=false (a conexao e criptografada via STARTTLS)
#   porta 465 -> SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fluxy <seu-email@seudominio.com.br>

# So para testar no seu computador sem provedor de e-mail: com "console" o
# e-mail nao e enviado e o link aparece no terminal. Ignorado em producao.
# MAIL_MODE=console

# ---------- Opcoes avancadas ----------
# Sites de outros enderecos autorizados a chamar a API (separados por
# virgula). Em branco = somente o proprio site, que e o normal.
# CORS_ORIGINS=https://meusite.github.io

# Use "true" apenas se houver um proxy reverso confiavel na frente (Nginx,
# Render, Railway...). Faz o limite de tentativas enxergar o IP real do visitante.
# TRUST_PROXY=true

# Cookie da sessao com "Secure" (so viaja por HTTPS). Fica ligado sozinho em
# producao ou quando APP_URL comeca com https://; force aqui so se precisar.
# COOKIE_SECURE=true
